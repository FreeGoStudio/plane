{
  "tools": [
    {
      "name": "list_accessible_projects",
      "description": "List only projects visible to the authenticated Plane user.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspace": {
            "type": ["string", "null"]
          },
          "search": {
            "default": "",
            "type": "string"
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "search_work_items",
      "description": "Search visible work items; similarity never authorizes overwriting.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "project_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "keyword": {
            "default": "",
            "type": "string"
          },
          "workspace": {
            "type": ["string", "null"]
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["project_ref"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_work_item",
      "description": "Read a visible work item and its exact update version.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "project_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "item_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "workspace": {
            "type": ["string", "null"]
          }
        },
        "required": ["project_ref", "item_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_my_capabilities",
      "description": "Show current capability hints; every actual write is checked again.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "project_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "item_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "workspace": {
            "type": ["string", "null"]
          }
        },
        "required": ["project_ref"],
        "additionalProperties": false
      }
    },
    {
      "name": "save_discussion_result",
      "description": "Explicit archive only. First prepare_create/prepare_update, then commit its decision_id. Preparing does not write Plane. Retry exactly that ID after transport failures. Updates require a previously read version. Never archive exploratory discussion or overwrite similar titles.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "intent": {
            "type": "string",
            "enum": ["prepare_create", "prepare_update", "commit"]
          },
          "project_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ]
          },
          "description_markdown": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50000
              },
              {
                "type": "null"
              }
            ]
          },
          "decision_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "existing_work_item_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "expected_updated_at": {
            "type": ["string", "null"]
          },
          "workspace": {
            "type": ["string", "null"]
          },
          "work_item_type": {
            "type": ["string", "null"]
          },
          "append": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": ["intent"],
        "additionalProperties": false
      }
    }
  ]
}
