    {
      "name": "save_discussion_result",
      "description": "Explicit archive only. First prepare_create/prepare_update, then commit its decision_id.\n\n        Preparing does not write Plane. Commit exactly the returned decision ID;\n        retry that ID after transport failures. Updates require a previously read\n        version. Never archive exploratory discussion or auto-overwrite similar titles.\n        ",
      "inputSchema": {
        "properties": {
          "intent": {
            "title": "Intent",
            "type": "string"
          },
          "project_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Project Ref"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          },
          "description_markdown": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description Markdown"
          },
          "decision_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Decision Id"
          },
          "existing_work_item_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Existing Work Item Id"
          },
          "expected_updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expected Updated At"
          },
          "workspace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Workspace"
          },
          "work_item_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Work Item Type"
          },
          "append": {
            "default": true,
            "title": "Append",
            "type": "boolean"
          }
        },
        "required": ["intent"],
        "title": "save_discussion_resultArguments",
        "type": "object"
      }
    }
