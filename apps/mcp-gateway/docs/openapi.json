  "components": {
    "securitySchemes": {
      "planeSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session-id",
        "description": "Actual cookie name is deployment configured; mutations require CSRF."
      },
      "delegatedBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Short-lived Plane-audience token from the controlled exchange; never a Gateway token."
      }
    },
    "schemas": {
      "Archive": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255
          },
          "description_markdown": {
            "type": "string",
            "maxLength": 50000
          },
          "expected_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "append": {
            "type": "boolean"
          },
          "work_item_type": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "Commit": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255
          },
          "description_markdown": {
            "type": "string",
            "maxLength": 50000
          },
          "expected_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "append": {
            "type": "boolean"
          },
          "work_item_type": {
            "type": "string"
          },
          "decision_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "Host": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": ["gitlab", "github"]
          },
          "api_url": {
            "type": "string",
            "format": "uri"
          },
          "web_url": {
            "type": "string",
            "format": "uri"
          },
          "allowed_networks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allow_http": {
            "type": "boolean"
          },
          "company_primary": {
            "type": "boolean"
          }
        },
        "required": ["name", "provider", "api_url", "web_url"],
        "additionalProperties": false
      },
      "Credential": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 8192
          },
          "expires_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "required": ["label", "token"],
        "additionalProperties": false
      },
      "Access": {
        "type": "object",
        "properties": {
          "credential_id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "anonymous": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "Repository": {
        "type": "object",
        "properties": {
          "credential_id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "anonymous": {
            "type": "boolean"
          },
          "instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "enum": ["development", "reference", "documentation"]
          },
          "default_branch": {
            "type": "string"
          }
        },
        "required": ["instance_id", "path", "purpose"],
        "additionalProperties": false
      },
      "RepositoryUpdate": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": ["development", "reference", "documentation"]
          },
          "default_branch": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "Prepared": {
        "type": "object",
        "properties": {
          "status": {
            "const": "prepared"
          },
          "decision_id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "content_digest": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "WorkItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description_html": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "work_item_identifier": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
